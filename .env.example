# Local-only launcher needs no account; never enable local mode on a public server.
AUTH_PROVIDER=legacy
# Run node scripts/create-account.mjs admin to create secrets in .env.local.
AUTH_SECRET=
AUTH_USERS_JSON=[]

# Optional Supabase authentication (server-only publishable key).
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Local OCR (optional, install the CLI separately).
# STUDIO_PORT=3102
# STUDIO_DATA_DIR=/absolute/private/task-directory
# MINERU_BACKEND=open-api
# MINERU_CLI=/absolute/path/to/mineru-open-api
# MINERU_API_TOKEN=configure_privately
