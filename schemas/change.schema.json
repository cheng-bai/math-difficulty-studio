{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "studio-change-v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "expectedReleaseId": {
      "type": "string",
      "minLength": 1
    },
    "paperId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "value": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "const": "studio-unit-v1"
              },
              "id": {
                "type": "string",
                "pattern": "^\\d+(\\(\\d+\\))?$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "单选",
                  "多选",
                  "填空",
                  "解答"
                ]
              },
              "points": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "optional": {
                "type": "boolean"
              },
              "module": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "question": {
                    "type": "string"
                  },
                  "answer": {
                    "type": "string"
                  },
                  "solution": {
                    "type": "string"
                  },
                  "teaching": {
                    "type": "string"
                  }
                },
                "required": [
                  "question",
                  "answer",
                  "solution",
                  "teaching"
                ]
              },
              "analysis_input": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "input": {
                          "type": "string",
                          "minLength": 1
                        },
                        "action": {
                          "type": "string",
                          "minLength": 1
                        },
                        "output": {
                          "type": "string",
                          "minLength": 1
                        },
                        "dependencies": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        },
                        "dimensions": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "K": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 2
                            },
                            "R": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 2
                            },
                            "A": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 2
                            },
                            "V": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 2
                            },
                            "P": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 2
                            },
                            "I": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 2
                            }
                          },
                          "required": [
                            "K",
                            "R",
                            "A",
                            "V",
                            "P",
                            "I"
                          ]
                        },
                        "dimension_evidence": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "K": {
                              "type": "string",
                              "minLength": 1
                            },
                            "R": {
                              "type": "string",
                              "minLength": 1
                            },
                            "A": {
                              "type": "string",
                              "minLength": 1
                            },
                            "V": {
                              "type": "string",
                              "minLength": 1
                            },
                            "P": {
                              "type": "string",
                              "minLength": 1
                            },
                            "I": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "K",
                            "R",
                            "A",
                            "V",
                            "P",
                            "I"
                          ]
                        },
                        "commentary": {
                          "type": "string"
                        },
                        "phase_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_ref": {
                          "type": "string"
                        },
                        "repeat_group": {
                          "type": "string",
                          "minLength": 1
                        },
                        "repeat_evidence": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "type_id",
                        "input",
                        "action",
                        "output",
                        "dependencies",
                        "dimensions",
                        "dimension_evidence"
                      ]
                    }
                  },
                  "phases": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "type_id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "goal": {
                          "type": "string"
                        },
                        "direction": {
                          "type": "string"
                        },
                        "output": {
                          "type": "string"
                        },
                        "step_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "goal",
                        "direction",
                        "output",
                        "step_ids"
                      ]
                    }
                  },
                  "risks": {
                    "type": "array",
                    "minItems": 5,
                    "maxItems": 5,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "item": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 5
                        },
                        "value": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2
                        },
                        "evidence": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "item",
                        "value",
                        "evidence"
                      ]
                    }
                  },
                  "B": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "B_evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "branches": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pending": {
                    "type": "boolean"
                  },
                  "issue": {
                    "type": "string"
                  }
                },
                "required": [
                  "steps",
                  "phases",
                  "risks",
                  "B",
                  "B_evidence",
                  "branches",
                  "pending",
                  "issue"
                ]
              },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "schema_version",
              "id",
              "revision",
              "n",
              "kind",
              "points",
              "optional",
              "module",
              "content",
              "analysis_input",
              "source_ids"
            ]
          }
        },
        "required": [
          "expectedRevision",
          "value"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "requestId",
    "expectedReleaseId",
    "paperId",
    "reason",
    "units"
  ]
}
